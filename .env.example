# Copy to .env and fill in. Never commit .env.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Optional for slice 1: when set, events are also appended to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Agent loop guards (TECH_BRIEF section 3).
AGENT_TOOL_CALL_CAP=8
AGENT_TURN_TIMEOUT_MS=55000
